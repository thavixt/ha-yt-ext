{
  "manifest_version": 3,
  "name": "Play on TV (Home Assistant)",
  "version": "0.1.0",
  "description": "Unofficial. Right-click a YouTube link to play it on the TV through a Home Assistant script.",
  "permissions": ["contextMenus", "storage", "notifications", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TV controls",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon192.png",
      "128": "icons/icon192.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon192.png",
    "128": "icons/icon192.png"
  }
}
